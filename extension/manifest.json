{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.2",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://companion.mines.paris/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/theme.js",
        "src/scoring.js",
        "src/mirror.js",
        "src/badge.js",
        "src/models.js",
        "src/adapters/factory.js",
        "src/adapters/chatgpt.js",
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/i18n.js",
        "src/theme.js",
        "src/scoring.js",
        "src/mirror.js",
        "src/badge.js",
        "src/models.js",
        "src/adapters/factory.js",
        "src/adapters/claude.js",
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/theme.js",
        "src/scoring.js",
        "src/mirror.js",
        "src/badge.js",
        "src/models.js",
        "src/adapters/factory.js",
        "src/adapters/gemini.js",
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "src/i18n.js",
        "src/theme.js",
        "src/scoring.js",
        "src/mirror.js",
        "src/badge.js",
        "src/models.js",
        "src/adapters/factory.js",
        "src/adapters/mistral.js",
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/theme.js",
        "src/scoring.js",
        "src/mirror.js",
        "src/badge.js",
        "src/models.js",
        "src/adapters/factory.js",
        "src/adapters/grok.js",
        "src/config.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://companion.mines.paris/*"
      ],
      "js": [
        "src/presence.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "I-BE³ Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
